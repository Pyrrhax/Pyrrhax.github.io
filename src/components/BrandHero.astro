---
import SystemVisual from './SystemVisual.astro';
---

<section class="brand-hero" aria-labelledby="brand-title">
  <div class="brand-hero-copy">
    <p class="brand-tagline">Observe. Model. Judge. Review.</p>
    <h1 id="brand-title">0rbs</h1>
    <p class="brand-lede">0rbs is a personal system for observation, judgment, and structured thinking.</p>
    <p class="brand-lede cn">0rbs 是一个围绕观察、判断与结构化思考<br class="mobile-soft-break" />构建的个人系统。</p>
    <div class="brand-axis" aria-label="系统关键词">
      <span>Observation</span>
      <span>Judgment</span>
      <span>Models</span>
      <span>Review</span>
    </div>
  </div>
  <SystemVisual />
</section>
