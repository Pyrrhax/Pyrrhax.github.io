---
import BrandHero from '../components/BrandHero.astro';
import RecentNotes from '../components/RecentNotes.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout
  title="0rbs"
  description="0rbs is a personal system for observation, judgment, and structured thinking."
  bodyClass="brand-surface"
>
  <main class="brand-home" id="top">
    <BrandHero />

    <section class="brand-statement" aria-labelledby="brand-statement-title">
      <p class="section-label">Brand Statement</p>
      <h2 id="brand-statement-title">A quiet interface for building personal judgment.</h2>
      <p>
        0rbs 是 Pyrrhax 用来整理观察、形成判断、沉淀模型和复盘决策的个人系统。它从安全、Web3、AI、投资与复杂系统中提取信号，把普通文章逐渐折叠成可检索、可复用、可迭代的结构。
      </p>
    </section>

    <RecentNotes posts={posts} />
  </main>
</BaseLayout>
